APP_NAME=Pixel Forge API
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://forge-pixel-forge.onrender.com
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,pixel-forge-api.onrender.com

MAX_UPLOAD_MB=8
MAX_IMAGE_PIXELS=25000000
MAX_MODEL_MB=100

OUTPUT_DIR=outputs
PRIVATE_SOURCE_DIR=private_sources
SOURCE_URL_TTL_SECONDS=3600
# Generate a unique random value for production. Never commit the real secret.
SOURCE_SIGNING_SECRET=development-only-source-signing-secret-change-me

# Vision provider secret. Keep the real value only in Render / local .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Hosted 3D provider
THREEWS_BASE_URL=https://three.ws
THREEWS_DEFAULT_TIER=draft
